# compiled output
/dist
/node_modules
/build
# Las subidas de usuarios no se versionan, pero sí los badges oficiales de las
# tiendas que usan las plantillas de correo (fuente SVG + PNG servido).
# Tiene que ser `assets/*` y no `assets/`: git no re-incluye nada si el
# directorio padre está excluido.
assets/*
!assets/email/

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store

# Tests
/coverage
/.nyc_output

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# DigitalOcean App Spec backups (local-only, may contain secret references)
app-actual-backup.yaml
app-*.backup.yaml
