# Database Configuration
DB_HOST=localhost
DB_PORT=3307
DB_USERNAME=root
DB_PASSWORD=password
DB_DATABASE=clyps

# App Configuration
NODE_ENV=development
PORT=4000

# CORS: dominios de frontend permitidos, separados por comas.
# Vacío = permite todos los orígenes (solo para desarrollo).
# Ejemplo: CORS_ORIGINS=https://app.tudominio.com,http://localhost:3000
CORS_ORIGINS=

SUBSCRIPTION_RATE_TYPE=oficial
SUBSCRIPTION_RATE_SOURCES=dolarapi,erapi,bcv


# JWT Configuration
JWT_SECRET=your-jwt-secret-key-change-this
JWT_EXPIRATION=7d

# Firebase Cloud Messaging (push notifications) — service account of clyps-app.
# JSON de la service account codificado en base64. SECRETO: nunca commitear.
# Si se deja vacío, el push FCM queda deshabilitado (solo socket).
FIREBASE_CREDENTIALS_BASE64=
# ---------------------------------------------------------------------------
# ONB-4 · Rescate de onboarding
# ---------------------------------------------------------------------------
# Correo del consultor que recibe el digest diario de rescates.
# Vacío = el cron detecta y loguea, pero no envía nada.
ONBOARDING_CONSULTANT_EMAIL=

# Umbrales en días SIN AVANZAR de paso (no desde el registro).
ONBOARDING_STUCK_REMINDER_DAYS=2
ONBOARDING_STUCK_ALERT_DAYS=4
ONBOARDING_STUCK_RISK_DAYS=7

# Llave para los endpoints internos de plataforma (header x-internal-key).
# Vacía = /onboarding/rescue-queue y /onboarding/rescue-sweep quedan cerrados.
ONBOARDING_INTERNAL_KEY=

# ---------------------------------------------------------------------------
# SUB-2 · Cotización del monto en Bs (tasa USD→VES)
# ---------------------------------------------------------------------------
# Qué tasa del BCV se usa para cobrar: oficial (dólar) o euro. Lo decide el
# desarrollador; el dueño solo ve el monto resultante.
SUBSCRIPTION_RATE_TYPE=oficial

# Fuentes en orden de intento: la primera es la primaria, las demás el respaldo.
# Ids válidos: dolarapi, erapi, bcv (ver src/subscription/config/rate.config.ts
# para la URL y el campo exacto de cada una).
SUBSCRIPTION_RATE_SOURCES=dolarapi,erapi,bcv

# Timeout por intento e intentos por fuente antes de pasar a la siguiente.
SUBSCRIPTION_RATE_TIMEOUT_MS=4000
SUBSCRIPTION_RATE_ATTEMPTS=2

# Banda de cordura: una tasa fuera de este rango se descarta como absurda.
SUBSCRIPTION_RATE_MIN=1
SUBSCRIPTION_RATE_MAX=100000

# Vigencia de una cotización y cuánto puede moverse la tasa congelada contra la
# de hoy antes de exigir recotizar (500 bps = 5%).
SUBSCRIPTION_QUOTE_TTL_HOURS=3
SUBSCRIPTION_QUOTE_RATE_TOLERANCE_BPS=500


# ---------------------------------------------------------------------------
# SUB-4 · Cola de verificación de pagos
# ---------------------------------------------------------------------------
# Cuánto puede desviarse el monto reportado del esperado antes de marcarlo como
# "monto no coincide" (100 bps = 1%). Marcar NO rechaza: el admin decide.
SUBSCRIPTION_AMOUNT_TOLERANCE_BPS=100

# ---------------------------------------------------------------------------
# SUB-5 · Control de acceso (entitlements)
# ---------------------------------------------------------------------------
# Días de gracia tras vencer el período (o la prueba) antes de bloquear.
# Un pago reportado y sin verificar concede acceso aunque esta ventana se agote.
SUBSCRIPTION_GRACE_DAYS=5

# ---------------------------------------------------------------------------
# SUB-10 · Verificación automática de pagos con Cobrix
# ---------------------------------------------------------------------------
# Cobrix concilia contra los bancos venezolanos: el dueño paga por transferencia
# o pago móvil y quien confirma que el dinero entró es su webhook, no un admin.
# El circuito es: emitimos el DOCUMENTO DE COBRO antes de pagar → el dueño paga
# → llega `invoice.paid` → se verifica el pago y se extiende el período.
#
# Sin API key o sin secreto del webhook, la integración queda apagada y todo se
# verifica a mano (SUB-4), que es el comportamiento seguro por defecto.

# Llave de la API (Configuración → Integraciones → API Keys en su panel).
COBRIX_API_KEY=
# ⚠️ EL AMBIENTE LO DECIDE ESTA URL, NO EL PREFIJO DE LA LLAVE: las llaves de
# sandbox también empiezan por cbx_live_. Apuntar producción a sandbox emite
# facturas que nadie va a pagar; al revés, cobra de verdad.
#   Sandbox:    https://sandbox-api.cobrix.co/api  (por defecto)
#   Producción: https://api.cobrix.co/api
COBRIX_API_URL=https://sandbox-api.cobrix.co/api
# Identifica de qué sistema nuestro viene el cobro dentro de la cuenta de
# Cobrix. Es también el prefijo de la referencia (clyps-<companyId>-<epoch>).
COBRIX_PROVIDER=clyps
# ⚠️ Moneda de la cuenta de Cobrix (pestaña Moneda de su panel). Su API pública
# de facturas NO lleva campo de moneda: manda solo un número. Si la cuenta está
# en bolívares y aquí se pone USD, se factura el precio del plan como si fueran
# bolívares.
COBRIX_CURRENCY=VES
# Cuánto vale el enlace de pago antes de cerrarse solo y poder pedir otro.
COBRIX_INVOICE_TTL_HOURS=24
COBRIX_REQUEST_TIMEOUT_MS=15000

# --- Webhooks: SON DOS CANALES CON DOS SECRETOS DISTINTOS ---
# Canal de DOCUMENTOS (cobrix_invoice_v1) → POST /webhooks/cobrix
# Es el que confirma el cobro con invoice.paid. Firma: HMAC-SHA256 del cuerpo
# crudo, sin timestamp, en x-cobrix-signature.
COBRIX_WEBHOOK_SECRET=
# Canal GENERAL → POST /webhooks/cobrix/general
# Solo avisa que el dueño terminó el checkout; no confirma nada. Otra fórmula:
# X-Cobrix-Signature: t=…,v1=… sobre "timestamp.cuerpo". Opcional.
COBRIX_GENERAL_WEBHOOK_SECRET=
# Ventana del timestamp firmado del canal general, en segundos. 300 es lo que
# documenta Cobrix: bajarlo rompe la integración con el reloj corrido, subirlo
# permite reenviar webhooks viejos.
COBRIX_WEBHOOK_TOLERANCE_SECONDS=300
# Segmento secreto opcional de la ruta: deja el endpoint en
# /webhooks/cobrix/<token>. Es cosmético — la firma es lo que protege.
COBRIX_WEBHOOK_PATH_TOKEN=

# Apaga la conciliación automática aunque llave y secreto estén puestos.
COBRIX_ENABLED=true
# Métodos que Cobrix concilia. Los demás nacen marcados 'unsupported' y van
# directo a la cola manual.
COBRIX_METHODS=pago_movil
# Horas de espera del webhook antes de escalar el pago a revisión manual. Los
# reintentos de Cobrix llegan hasta las 24 h, así que por debajo de eso solo se
# adelanta el aviso al admin: el webhook tardío se procesa igual.
COBRIX_WEBHOOK_WAIT_HOURS=6

# ---------------------------------------------------------------------------
# Conexion TLS a la base
# ---------------------------------------------------------------------------
# Las bases gestionadas de DigitalOcean exigen TLS por la red publica (puerto
# 25060). Dentro del VPC se usa el host privado (.i.db.ondigitalocean.com) y no
# hace falta. CI lo pone en true; en DigitalOcean se deja vacio.
DB_SSL=
# Opcional: certificado CA de la base en base64. Si se deja vacio y DB_SSL=true,
# se cifra igual pero sin verificar el certificado del servidor.
DB_SSL_CA=
